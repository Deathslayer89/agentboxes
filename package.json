{
  "name": "agentbox",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted sandboxes for AI agents: gVisor isolation on any Linux box, no KVM needed",
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "stop": "kill $(cat data/agentbox.pid)",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc",
    "agentbox": "tsx src/cli.ts",
    "example": "tsx examples/sdk-basic.ts",
    "mcp": "tsx mcp/server.ts",
    "bench": "tsx bench/run.ts",
    "build:sdk": "tsc -p sdk/tsconfig.json",
    "test": "tsx --test test/unit/*/*.test.ts",
    "test:integration": "tsx --test test/integration/sandbox.test.ts",
    "test:python": "python3 -m unittest discover -s sdk-python/tests -v",
    "test:firecracker": "tsx --test test/integration/firecracker.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.11.1",
    "dockerode": "^5.0.1",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
